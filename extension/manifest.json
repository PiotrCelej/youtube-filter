{
  "manifest_version": 3,
  "name": "YouTube — tylko subskrypcje",
  "version": "1.1.1",
  "description": "Filtruje rekomendacje YouTube i dodaje filmy z ostatniego miesiąca ze subskrybowanych kanałów. Z przełącznikiem.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*"],
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": {
    "default_title": "YouTube — tylko subskrypcje",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" }
  },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
    "js": ["core.js", "subscriptions.js", "uploads.js", "uploads-view.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_start"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
